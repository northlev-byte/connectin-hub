{
  "rewrites": [
    { "source": "/", "destination": "/connectin-hub.html" },
    { "source": "/scheduler", "destination": "/scheduler.html" },
    { "source": "/password", "destination": "/password.html" },
    { "source": "/profile", "destination": "/profile.html" },
    { "source": "/logout", "destination": "/logout.html" },
    { "source": "/financials", "destination": "/connectin-financials.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "Cache-Control", "value": "no-store" }
      ]
    }
  ]
}
